  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
