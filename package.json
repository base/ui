    "@vercel/analytics": "^2.0.1",
    "classnames": "^2.5.1",
    "d3": "^7.9.0",
    "morphicons": "^1.7.0",
    "motion": "^12.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "swr": "^2.5.0",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.55.10"
